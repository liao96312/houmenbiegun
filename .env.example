AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_PROVIDER=nvidia
AI_FALLBACK_PROVIDER=deepseek
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro
NVIDIA_REASONING_EFFORT=none
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=deepseek-chat
DEEPSEEK_THINKING=disabled
TTS_ENABLED=false
# 必填：后台口令。所有 /api/admin/* 接口都要求请求头 X-Admin-Token 与之一致；
# 留空则后台接口一律返回 503（默认拒绝）。请使用 32 位以上随机 ASCII 字符串，例如：
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# 可选：python -m app.server 的监听地址和端口。本机运行默认 127.0.0.1:8000（只允许本机访问）。
# Docker 部署不需要改：docker-compose.yml 会强制 HOST=0.0.0.0、PORT=8000。
# 不用 Docker 又想让局域网/公网直接访问时才设 HOST=0.0.0.0（建议前面加 nginx 反代）。
# HOST=127.0.0.1
# PORT=8000
