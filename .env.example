AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
TTS_ENABLED=false
ADMIN_TOKEN=
# 可选：python -m app.server 的监听地址和端口。本机运行默认 127.0.0.1:8000（只允许本机访问）。
# Docker 部署不需要改：docker-compose.yml 会强制 HOST=0.0.0.0、PORT=8000。
# 不用 Docker 又想让局域网/公网直接访问时才设 HOST=0.0.0.0（建议前面加 nginx 反代）。
# HOST=127.0.0.1
# PORT=8000
