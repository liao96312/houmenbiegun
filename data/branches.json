{
  "_meta": {
    "purpose": "预置分支语料：当用户不知道说什么时，给出 2-3 个真实可说的人话选项，每个选项接一句手写的陪伴回复，并附'陪伴手法解析'说明为什么这么接。分支模式不依赖大模型，离线可用，保证每一句都到位。",
    "inspired_by": "参考 what.arksec.net 聊天模拟器的'选项推进剧情 + 手法解析'形态，把 PUA 操控解析反转为陪伴/倾听手法解析。",
    "structure": {
      "start": "起始节点 id",
      "nodes": {
        "node_id": {
          "companion_line": "陪伴者这一句",
          "analysis": "陪伴手法解析：为什么这么接，对应哪条倾听原则",
          "options": [
            {
              "label": "用户选项",
              "next": "下一节点 id"
            }
          ],
          "is_ending": false,
          "ending_type": "loosened | calm | safety"
        }
      }
    },
    "endings": {
      "loosened": "用户好像松了一点，正向收尾",
      "calm": "平静中性收尾，不强行升华",
      "safety": "检测到高风险，退出场景，转介现实帮助"
    },
    "note": "选项只学节奏与分寸，不替代自由聊天；用户随时可切回自由输入。"
  },
